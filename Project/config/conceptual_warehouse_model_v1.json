  "business_constraints": [
    {
      "title": "Đúng grain trước khi cộng",
      "rule": "Booking, đêm phòng, hóa đơn, phiên buffet và lượt vào là các sự kiện khác nhau. Tổng hợp từng nguồn về cùng mức trước khi so sánh; không nối nhiều fact chi tiết rồi cộng tiền."
    },
    {
      "title": "Tỷ lệ tính lại từ các số cơ sở",
      "rule": "Công suất, tỷ lệ dùng quyền lợi, đáp ứng hàng và hao hụt đều là số đo không cộng được. Tính tổng tử / tổng mẫu; mẫu số 0 để trống, không gán 0%."
    },
    {
      "title": "Số dư theo thời điểm và đơn vị",
      "rule": "Tồn cuối ngày không cộng qua nhiều ngày. Lượng chỉ cộng khi đơn vị tương thích; giá trị VND cộng được giữa các mặt hàng. Giá danh mục không thay giá giao dịch."
    },
    {
      "title": "Giữ ngữ cảnh lịch sử",
      "rule": "Phân loại giao dịch theo thuộc tính và quan hệ tại thời điểm nghiệp vụ. Đã chọn giữ phiên bản; v2 hiện có một phiên bản khởi tạo theo giả định mô phỏng."
    },
    {
      "title": "Báo cáo phần hợp lệ và nói rõ phần thiếu",
      "rule": "Khi còn lỗi, báo cáo vẫn dùng tập hợp lệ với nhãn thiếu và phạm vi ảnh hưởng. Không đủ dữ liệu khác với không phát sinh; không tự thay giá trị thiếu bằng 0."
    },
    {
      "title": "Phạm vi và giới hạn của mô hình",
      "rule": "Chưa bổ sung KPI hội viên, dòng tiền, ROI, lợi nhuận đầy đủ hay định danh khách toàn chuỗi. Chưa suy mùa du lịch, tỉnh/vùng hành chính hoặc kho vật lý riêng từ nguồn không có thuộc tính đó."
    }
