  "metric_mapping": [
    {
      "id": "B01.01",
      "name": "Đêm phòng thực ở",
      "date_role": "stay_date",
      "formula": "COUNTD(room_id, stay_date) trong kỳ từ stay của booking COMPLETED",
      "primary_facts": [
        "F03"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B01.02",
      "name": "Đêm phòng khả dụng",
      "date_role": "calendar_date",
      "formula": "COUNTD(room_id, date) trong kỳ không ngừng bán",
      "primary_facts": [
        "F02"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B01.03",
      "name": "Công suất phòng",
      "date_role": "stay_date/calendar_date",
      "formula": "DIV(B01.01, B01.02)",
      "primary_facts": [
        "F03",
        "F02"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B01.04",
      "name": "Tỷ lệ booking hủy",
      "date_role": "bookings.arrival cohort",
      "formula": "COUNTD(booking_id có status CANCELLED)/COUNTD(booking_id) trong cohort ngày arrival thuộc kỳ",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B01.05",
      "name": "Tỷ lệ booking no-show",
      "date_role": "bookings.arrival cohort",
      "formula": "COUNTD(booking_id có status NO_SHOW)/COUNTD(booking_id) trong cùng cohort arrival",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B02.01",
      "name": "Giá trị gói phòng trước giảm",
      "date_role": "bookings.departure",
      "formula": "SUM(gross_vnd)",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B02.02",
      "name": "Giá trị khách phải trả",
      "date_role": "bookings.departure",
      "formula": "SUM(customer_due_vnd) = SUM(gross_vnd − discount_vnd)",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B02.03",
      "name": "Chi phí giảm giá CompanyE chịu",
      "date_role": "bookings.departure",
      "formula": "SUM(company_share_vnd)",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B02.04",
      "name": "Phần giảm giá đối tác tài trợ",
      "date_role": "bookings.departure",
      "formula": "SUM(partner_share_vnd)",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B02.05",
      "name": "Hoa hồng phân phối",
      "date_role": "bookings.departure",
      "formula": "SUM(commission_vnd)",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B02.06",
      "name": "Giá trị giữ lại trước chi phí vận hành",
      "date_role": "bookings.departure",
      "formula": "B02.01 − B02.03 − B02.05 = B02.02 + B02.04 − B02.05",
      "primary_facts": [
        "F01"
      ],
      "supporting_facts": [],
      "optional_facts": []
    },
    {
      "id": "B03.01",
      "name": "Booking có mua chéo",
      "date_role": "hotel bookings.departure cohort",
      "formula": "COUNTD(booking_id trong cohort thỏa điều kiện mua chéo)",
      "primary_facts": [
        "F04",
        "F05"
      ],
      "supporting_facts": [
        "F01"
      ],
      "optional_facts": []
    },
    {
      "id": "B03.02",
      "name": "Tỷ lệ booking có mua chéo",
      "date_role": "hotel bookings.departure cohort",
      "formula": "DIV(B03.01, COUNTD(booking_id COMPLETED trong cohort))",
      "primary_facts": [
        "F04",
        "F05"
      ],
      "supporting_facts": [
        "F01"
      ],
      "optional_facts": []
    },
    {
      "id": "B03.03",
      "name": "Giá trị vé sau hoàn gắn booking",
      "date_role": "hotel bookings.departure cohort",
      "formula": "SUM(gross_vnd − refunded_vnd) của các ticket_order liên kết cohort",
      "primary_facts": [
        "F04"
      ],
      "supporting_facts": [
        "F01"
      ],
      "optional_facts": []
    },
    {
      "id": "B03.04",
