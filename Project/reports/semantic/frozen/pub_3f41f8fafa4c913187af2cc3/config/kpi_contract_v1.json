          "date_role": "movement_date; opening before S, closing before E",
          "zero_denominator": "not_applicable",
          "implementation_status": "SPECIFIED_NOT_IMPLEMENTED"
        },
        {
          "id": "B07.02",
          "name": "Tồn cuối kỳ",
          "formula": "SUM(Q1)",
          "unit": "Đơn vị chuẩn; không cộng các tồn cuối ngày",
          "aggregation": "period_balance",
          "date_role": "movement_date; opening before S, closing before E",
          "zero_denominator": "not_applicable",
          "implementation_status": "SPECIFIED_NOT_IMPLEMENTED"
        },
        {
          "id": "B07.03",
          "name": "Lượng sử dụng trong kỳ",
          "formula": "SUM(U)",
          "unit": "Đơn vị chuẩn",
          "aggregation": "sum",
          "date_role": "movement_date; opening before S, closing before E",
          "zero_denominator": "not_applicable",
          "implementation_status": "SPECIFIED_NOT_IMPLEMENTED"
        },
        {
          "id": "B07.04",
          "name": "Lượng hủy trong kỳ",
          "formula": "SUM(W)",
          "unit": "Đơn vị chuẩn",
          "aggregation": "sum",
          "date_role": "movement_date; opening before S, closing before E",
          "zero_denominator": "not_applicable",
          "implementation_status": "SPECIFIED_NOT_IMPLEMENTED"
        },
        {
          "id": "B07.05",
          "name": "Giá trị hao hụt trong kỳ",
          "formula": "SUM(quantity × unit_price_vnd) của WASTE trong kỳ theo từng lô",
          "unit": "VND; cộng được giữa mặt hàng",
