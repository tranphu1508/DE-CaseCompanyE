          "zero_denominator": "not_applicable",
          "implementation_status": "SPECIFIED_NOT_IMPLEMENTED"
        },
        {
          "id": "B07.06",
          "name": "Tỷ lệ hao hụt theo giá trị sẵn có",
          "formula": "DIV(giá trị WASTE trong kỳ, giá trị tồn đầu kỳ + giá trị IN trong kỳ), định giá từng lô",
          "unit": "%; tính lại từ tổng giá trị",
          "aggregation": "ratio_of_totals",
          "date_role": "movement_date; opening before S, closing before E",
          "zero_denominator": "BLANK",
          "implementation_status": "SPECIFIED_NOT_IMPLEMENTED"
        }
      ]
