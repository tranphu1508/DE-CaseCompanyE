          {
            "name": "B01.01 state",
            "expression": "SWITCH(TRUE(), ISFILTERED(Engine[engine]) && NOT HASONEVALUE(Engine[engine]),\"CHỌN MỘT ENGINE\", ISFILTERED(Period[period]) && NOT HASONEVALUE(Period[period]),\"CHỌN MỘT KỲ\", ISFILTERED(D06[promotion_id]) || ISFILTERED(D09[outlet_id]) || ISFILTERED(D10[meal_code]) || ISFILTERED(D11[centre_id]) || ISFILTERED(D12[activity_id]) || ISFILTERED(D12[outdoor]) || ISFILTERED(D13[vehicle_type]) || ISFILTERED(D14[supplier_id]) || ISFILTERED(D15[item_id]) || ISFILTERED(D16[asset_type]) || ISFILTERED(F14[usage_area]) || ISFILTERED(F16[work_type]),\"BỘ LỌC KHÔNG ÁP DỤNG\", FALSE(),\"CHỌN MỘT MẶT HÀNG\", FALSE(),\"BỮA ĂN NGOÀI PHẠM VI\", \"COMPLETE\")",
