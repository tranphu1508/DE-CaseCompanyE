        "lineageTag": "363932db-a6a5-447b-913b-dfbb56aafb54",
        "measures": [
          {
            "name": "B01.01 n",
            "expression": "VAR s = SELECTEDVALUE(Period[start_key],20240101) VAR e = SELECTEDVALUE(Period[end_key],20260101) VAR eng = SELECTEDVALUE(Engine[engine],\"oracle\") RETURN COALESCE(CALCULATE(SUM(F03[occupied_night]), Engine[engine]=eng, F03[service_date_key] >= s, F03[service_date_key] < e),0)",
            "isHidden": true,
            "lineageTag": "ef9c029f-b11a-4ffc-a3b3-7351f7a22efb"
          },
          {
            "name": "B01.01 d",
