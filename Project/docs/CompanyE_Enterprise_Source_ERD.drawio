        <mxCell id="text0" value="Tách ba mốc thời gian: nghiệp vụ xảy ra, nguồn ghi nhận và hệ thống&lt;br&gt;nhận file. Giữ phiên bản và replay để tái lập, kiểm thử ETL." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=19;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="800" y="590" width="600" height="53.5" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Nguồn v2 đang xét là feed receipt có version/replay; CSV còn g/kg, thời gian nguồn và thời gian nhận khác nhau. File supplier_mixed, TEXT/SVG chưa chuẩn hóa của v1 thuộc batch/cấu trúc v1 riêng, không gán nhầm vào catalog v2. Phiếu nhận trong DB&lt;br&gt;là nguồn nghiệp vụ cho B06-B07; feed ngoài không tạo thêm lượng nhận." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=18;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1240" width="2040" height="51.0" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Nét đứt màu cam = đối chiếu/liên hệ thống; xanh = luồng dữ liệu; tím = metadata. Không suy quan hệ nhận diện khách từ tên, email hoặc thứ tự ID." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1330" width="2040" height="24.75" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="CompanyE | 13/10/2026 | Nguồn: DDL/contracts v2, catalog v2, lake_v2.py. Mẫu: CO5173 Chương 1 slide 63-65; bảng quan hệ theo ký hiệu PK/FK." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="1950" height="22.25" as="geometry" />
        </mxCell>
