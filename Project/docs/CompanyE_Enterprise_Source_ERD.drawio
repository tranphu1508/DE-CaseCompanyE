          <mxGeometry x="1742" y="1003" width="65" height="26" as="geometry" />
        </mxCell>
        <mxCell id="text0" value="Giả định case: Sa Pa, Đà Nẵng, Đà Lạt, Phú Quốc; mỗi cụm có một trung tâm và hai khách sạn (3 sao, 5 sao). Số lượng 4/2/1 là quy mô case, không phải ràng buộc UNIQUE/FK trong DDL. Điểm ăn uống bao gồm nhà hàng và bar; không giả định mỗi&lt;br&gt;khách sạn chỉ có một outlet." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=18;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1240" width="2040" height="51.0" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Các thực thể lặp giữa các trang là cùng khái niệm. Quan hệ khái niệm không thay thế ràng buộc SQL; phần II là tài liệu tham chiếu chính xác của nguồn v2." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1330" width="2040" height="24.75" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="CompanyE | 13/10/2026 | Nguồn: DDL/contracts v2, catalog v2, lake_v2.py. Mẫu: CO5173 Chương 1 slide 63-65; bảng quan hệ theo ký hiệu PK/FK." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="1950" height="22.25" as="geometry" />
        </mxCell>
      </root>
