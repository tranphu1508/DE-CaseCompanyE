              <mxPoint x="1410" y="1020" />
              <mxPoint x="1410" y="1020.27" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="text0" value="Cụm: site_code = site_id. Mỗi centre phải tìm thấy đúng một site;&lt;br&gt;không suy theo tên." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=19;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="765" y="200" width="580" height="53.5" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Bán chéo: kiểm tra tồn tại booking; giữ cơ sở phục vụ và cơ sở đặt&lt;br&gt;phòng riêng. Tổng dịch vụ về booking trước khi ghép KPI." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=19;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="765" y="465" width="580" height="53.5" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Hội viên: kiểm tra card, guest và membership nhất quán; khi phân&lt;br&gt;tích quyền lợi phải xét valid_from/valid_to và chính sách thẻ." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=19;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="765" y="890" width="580" height="53.5" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="booking_ref NULL = bán độc lập; ref có giá trị nhưng sai = lỗi cần quarantine, không đổi thành bán độc lập. guest_id và customer_id luôn có namespace. member_card_ref chỉ là bằng chứng liên kết khi đã xác minh, chưa tạo Golden Customer; không dùng&lt;br&gt;audit_only/identity truth để nối dữ liệu khai thác." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=18;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1240" width="2040" height="51.0" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Nét đứt màu cam = đối chiếu/liên hệ thống; xanh = luồng dữ liệu; tím = metadata. Không suy quan hệ nhận diện khách từ tên, email hoặc thứ tự ID." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1330" width="2040" height="24.75" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="CompanyE | 13/10/2026 | Nguồn: DDL/contracts v2, catalog v2, lake_v2.py. Mẫu: CO5173 Chương 1 slide 63-65; bảng quan hệ theo ký hiệu PK/FK." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="1950" height="22.25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
