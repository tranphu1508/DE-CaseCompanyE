        <mxCell id="edge19" edge="1" parent="1" source="rel9" target="card" style="html=1;fontFamily=Arial;whiteSpace=wrap;edgeStyle=segmentEdgeStyle;rounded=0;strokeColor=#303030;strokeWidth=1.6;startArrow=none;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
