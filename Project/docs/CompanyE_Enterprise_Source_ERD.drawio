        <mxCell id="text0" value="website_channel là TEXT, không có REFERENCES trong DDL. Thời tiết gắn với cụm; PK weather_id chưa bảo đảm UNIQUE(site_id, weather_date). Tính duy nhất theo grain cần kiểm tra chất lượng." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=18;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1240" width="2040" height="28.5" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="PK = khóa chính; FK = khóa ngoại khai báo; NN = NOT NULL; NULL = cho phép thiếu; UQ = UNIQUE. Một cha có 0..N con; FK NULL cho phép con có 0..1 cha, ngược lại đúng 1 cha." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=15;fontColor=#222222;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1330" width="2040" height="24.75" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="CompanyE | 13/10/2026 | Nguồn: DDL/contracts v2, catalog v2, lake_v2.py. Mẫu: CO5173 Chương 1 slide 63-65; bảng quan hệ theo ký hiệu PK/FK." style="html=1;fontFamily=Arial;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="1950" height="22.25" as="geometry" />
        </mxCell>
