        <mxCell id="counts" value="&lt;b&gt;Phạm vi đã chốt&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 dimension; 17 fact/context/aggregate; 2 bridge; 2 validation view.&lt;br&gt;631 cột; 102 FK fact-dimension.&lt;br&gt;F15 tùy chọn, F17 là ngữ cảnh." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="720" width="530" height="235" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;Cách đọc tài liệu&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trang 02-04: ký hiệu, lịch sử và chiều dùng chung. Trang 05-21: từng star với đủ cột fact. Trang 22-29: đủ cột dimension. Trang 30-33: bridge/view. Trang 34-35: đối chiếu B01-B08.&lt;br&gt;Các hộp dimension lặp trên nhiều trang là cùng một bảng; mã cha trong dimension vẫn là thuộc tính, không tạo snowflake FK." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="985" width="1660" height="150" />
        </mxCell>
