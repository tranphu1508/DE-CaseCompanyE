        <mxCell id="grainleft" value="&lt;b&gt;Một dòng đặt mua&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tiền/lượng đặt chỉ giữ một lần. Cùng purchase_line_id có thể có nhiều lần nhận.&lt;br&gt;Phân loại supplier/item/hotel theo thời điểm đặt." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="710" width="550" height="235" />
        </mxCell>
        <mxCell id="grainright" value="&lt;b&gt;Một lần nhận hàng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phân loại supplier/item/hotel theo thời điểm nhận. Cùng đối tượng có thể mang SK khác nếu đã đổi phiên bản." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="710" width="550" height="235" />
        </mxCell>
        <mxCell id="across" value="&lt;b&gt;Drill-across và chống nhân bản&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tổng hợp receipt về (namespace, purchase_line_id), rồi đối chiếu dòng mua; giữ cả dòng đến hạn chưa nhận. B06 dùng phân loại của dòng đặt mua cho cohort. Không nối trực tiếp hai fact chi tiết rồi SUM.&lt;br&gt;SK nhận diện phiên bản. Khi đối chiếu xuyên thời gian, dùng mã nghiệp vụ bền vững và grain đã chốt; không coi hai SK của cùng đối tượng là hai nhà cung cấp khác nhau." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="990" width="1660" height="160" />
        </mxCell>
        <mxCell id="footer" value="CompanyE | Logical 1.1 | Chú giải trang 02; SCD2 trang 03 | 04/35" style="text;html=1;fontFamily=Arial;fontSize=15;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1170" width="1660" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
