        <mxCell id="newtitle" value="D03 DimHotel - phiên bản sau" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontStyle=1;fontSize=21;fillColor=#F1F4F9;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="0" width="800" height="38" />
