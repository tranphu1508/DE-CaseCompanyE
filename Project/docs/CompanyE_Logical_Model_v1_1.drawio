        <mxCell id="subtitle" value="14 dimension dùng SCD Type 2; D01 DimDate và D10 DimMeal STATIC. Ví dụ dưới chỉ minh họa, không phải dữ liệu v2 mới." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;align=left;" vertex="1" parent="1">
