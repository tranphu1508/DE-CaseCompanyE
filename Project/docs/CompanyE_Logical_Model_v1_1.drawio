        <mxCell id="use" value="&lt;b&gt;Hợp nhất mã cụm giữa hai nguồn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Namespace trung tâm = entertainment_ops; namespace cụm = hotel_ops. centres.site_code ánh xạ sites.site_id, không đoán theo tên hoặc khoảng cách. Một centre ánh xạ một site; nhiều centre có thể cùng site." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="825" width="800" height="300" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;Giới hạn đường nối&lt;/b&gt;&lt;br&gt;&lt;br&gt;View hiện hành không lưu lịch sử riêng. Khi phân loại giao dịch lịch sử, phải tra thuộc tính site của phiên bản DimCentre đúng thời điểm theo quy tắc R17; không dùng crosswalk current thay lịch sử. Không tạo FK snowflake từ DimCentre sang DimSite." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="825" width="800" height="300" />
