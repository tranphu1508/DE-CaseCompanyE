        <mxCell id="D01keyrules" value="&lt;b&gt;Lịch sử: STATIC&lt;/b&gt;&lt;br&gt;&lt;br&gt;UK1: calendar_date&lt;br&gt;Một thành viên hiện hành cho mỗi business key trong namespace.&lt;br&gt;STATIC; không thêm khoảng hiệu lực.&lt;br&gt;Hai thành viên đặc biệt 0/-1 theo member_kind." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="875" width="800" height="270" />
        </mxCell>
        <mxCell id="D02keyrules" value="&lt;b&gt;Lịch sử: SCD_TYPE2&lt;/b&gt;&lt;br&gt;&lt;br&gt;BK: source_system, site_id&lt;br&gt;UK1: source_system, site_id, valid_from_utc&lt;br&gt;UK2: source_system, site_id, version_no&lt;br&gt;UK current: BK khi NORMAL và is_current=1.&lt;br&gt;Khoảng hiệu lực không chồng; chỉ một current/BK.&lt;br&gt;Các UK phiên bản chỉ áp dụng dòng NORMAL; xem trang 03." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
