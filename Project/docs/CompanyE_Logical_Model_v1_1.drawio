          <mxGeometry as="geometry" x="0" y="610" width="800" height="44" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Thuộc tính và số đo&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK: khóa chính. FK: tham chiếu PK dimension. BK: định danh nghiệp vụ trong namespace. UK: ràng buộc duy nhất (ghi theo nhóm cột). DD: mã giao dịch. SK: khóa thay thế.&lt;br&gt;T: thuộc tính theo dõi thay đổi. H: cột điều khiển lịch sử. A: audit/lineage. AT: thuộc tính còn lại.&lt;br&gt;!: NOT NULL. ?: cho NULL. N!: bắt buộc với member_kind=NORMAL; cho NULL ở thành viên đặc biệt.&lt;br&gt;[S]: FK có chính sách thành viên đặc biệt. Giá trị 0/-1 vẫn tham chiếu một dòng dimension; FK công bố không trở thành NULL.&lt;br&gt;M: SUM. MU: SUM cùng đơn vị. MS: số dư không cộng qua ngày. MSU: kết hợp hai hạn chế. MN: nhiệt độ lấy trung bình theo site/ngày. MT: mưa cộng qua ngày trong cùng site." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="180" width="810" height="640" />
        </mxCell>
        <mxCell id="card" value="&lt;b&gt;Quan hệ 1 - 0..N&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi dòng fact/bridge có FK tham chiếu đúng một dòng dimension, gồm cả dòng đặc biệt được phép. Một phiên bản dimension có thể được 0 đến nhiều dòng fact tham chiếu.&lt;br&gt;Nét liền: FK đã khai báo. Nét đứt: đối chiếu nghiệp vụ có kiểm soát, không phải FK hay đường cộng tiền mặc định." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="845" width="810" height="280" />
        </mxCell>
        <mxCell id="namespace" value="&lt;b&gt;Namespace và dữ liệu thiếu&lt;/b&gt;&lt;br&gt;&lt;br&gt;source_system là thành phần định danh, không phải nhãn trang trí. Hồ sơ khách ở hai nguồn chưa được hợp nhất thành khách duy nhất toàn chuỗi.&lt;br&gt;ID có giá trị nhưng sai hoặc không tìm được phiên bản phải được cách ly; không thay bằng UNKNOWN để che lỗi. Báo cáo công bố phần hợp lệ kèm nhãn thiếu." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="870" width="800" height="250" />
        </mxCell>
        <mxCell id="footer" value="CompanyE | Logical 1.1 | Chú giải trang 02; SCD2 trang 03 | 02/35" style="text;html=1;fontFamily=Arial;fontSize=15;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1170" width="1660" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
