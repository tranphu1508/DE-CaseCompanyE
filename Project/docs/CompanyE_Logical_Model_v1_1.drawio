          <mxGeometry as="geometry" x="0" y="155" width="800" height="39" />
        </mxCell>
        <mxCell id="oldr4" value="valid_to_utc = 2025-05-31 17:00:00" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="old">
          <mxGeometry as="geometry" x="0" y="194" width="800" height="39" />
        </mxCell>
        <mxCell id="oldr5" value="is_current = 0; version_no = 1" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="old">
          <mxGeometry as="geometry" x="0" y="233" width="800" height="39" />
