        <mxCell id="pkuk" value="&lt;b&gt;Khóa và tính duy nhất&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK: centre_source_system, centre_id&lt;br&gt;UK1: centre_source_system, centre_id" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
