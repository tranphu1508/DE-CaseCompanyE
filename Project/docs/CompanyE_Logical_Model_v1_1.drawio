        <mxCell id="newr0" value="PK hotel_key = 702" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="38" width="800" height="39" />
        </mxCell>
        <mxCell id="newr1" value="BK (source_system, hotel_id) = (hotel_ops, HOTEL_DEMO)" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="77" width="800" height="39" />
        </mxCell>
        <mxCell id="newr2" value="hotel_name = E Demo; stars = 5" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="116" width="800" height="39" />
        </mxCell>
        <mxCell id="newr3" value="valid_from_utc = 2025-05-31 17:00:00" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="155" width="800" height="39" />
        </mxCell>
        <mxCell id="newr4" value="valid_to_utc = NULL" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="194" width="800" height="39" />
        </mxCell>
        <mxCell id="newr5" value="is_current = 1; version_no = 2" style="html=1;rounded=0;strokeColor=#20334B;fontFamily=Arial;align=left;spacingLeft=12;fontSize=20;fillColor=#FFFFFF;" vertex="1" parent="new">
          <mxGeometry as="geometry" x="0" y="233" width="800" height="39" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b&gt;Tra cứu tại thời điểm nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nếu t &amp;lt; 2025-05-31 17:00:00 UTC trong khoảng phiên bản cũ, fact giữ hotel_key=701. Từ đúng ranh giới này, dùng hotel_key=702. Điều kiện: valid_from_utc &amp;lt;= t AND (t &amp;lt; valid_to_utc OR valid_to_utc IS NULL).&lt;br&gt;Không thay khóa của toàn bộ giao dịch cũ bằng current. Thời điểm t cụ thể được ghi ở từng trang fact." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="510" width="1660" height="160" />
        </mxCell>
        <mxCell id="constraint" value="&lt;b&gt;Ràng buộc trên dòng NORMAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;BK = namespace + mã nghiệp vụ. BK được lặp ở nhiều phiên bản.&lt;br&gt;UK1 = BK + valid_from_utc.&lt;br&gt;UK2 = BK + version_no.&lt;br&gt;UK có điều kiện = BK khi is_current=1.&lt;br&gt;Các khoảng [valid_from, valid_to) không chồng nhau. is_current=1 khi và chỉ khi valid_to_utc=NULL.&lt;br&gt;Hai dòng 0/-1 không phiên bản hóa.&lt;br&gt;version_no là thứ tự thời gian, không phải khóa bền vững; chèn lịch sử có thể làm đổi thứ tự." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="685" width="800" height="435" />
        </mxCell>
        <mxCell id="bootstrap" value="&lt;b&gt;Áp dụng cho dữ liệu tự sinh v2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi BK hiện có một phiên bản khởi tạo, từ 2023-01-01 00:00 giờ Việt Nam, tương đương 2022-12-31 17:00:00 UTC.&lt;br&gt;effective_time_basis=BOOTSTRAP_ASSUMPTION ghi rõ đây là giả định mô phỏng.&lt;br&gt;Hash không đổi thì không tạo phiên bản mới. Replay phải giữ nguyên khóa. Thay đổi đến muộn cần tách khoảng và tra lại các fact bị ảnh hưởng.&lt;br&gt;Fixture kiểm thử nhiều phiên bản sẽ tách khỏi seed v2. Tài liệu này chưa chứng minh ETL SCD2 đã chạy." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EDF4FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="685" width="800" height="435" />
        </mxCell>
        <mxCell id="footer" value="CompanyE | Logical 1.1 | Chú giải trang 02; SCD2 trang 03 | 03/35" style="text;html=1;fontFamily=Arial;fontSize=15;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1170" width="1660" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
