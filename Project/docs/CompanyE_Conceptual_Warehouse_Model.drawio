<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="conceptual-0" name="00-pham-vi"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="CompanyE - Mô hình ý niệm kho dữ liệu" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Quá trình, số đo, chiều và cấp tổng hợp | Chốt phạm vi B01-B08 | 13/10/2026" style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="intro" value="&lt;b&gt;Câu hỏi thiết kế&lt;/b&gt;&lt;br&gt;&lt;br&gt;Doanh nghiệp cần quan sát điều gì, ở mức chi tiết nào, theo những góc nhìn nào? Mô hình này độc lập Oracle/Iceberg; chưa mô tả khóa kỹ thuật, kiểu dữ liệu hoặc cách lưu bảng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="155" width="1470" height="110" /></mxCell><mxCell id="group0" value="&lt;b&gt;LƯU TRÚ VÀ BÁN HÀNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;P01 Đặt phòng&lt;br&gt;P02 Thực hiện lưu trú&lt;br&gt;P03 Phòng khả dụng&lt;br&gt;B01, B02 và cohort B03" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F7FAFE;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="310" width="470" height="245" /></mxCell><mxCell id="group1" value="&lt;b&gt;DỊCH VỤ KHÁCH HÀNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;P04 Bán vé; P05 Sử dụng hoạt động&lt;br&gt;P06 Thuê phương tiện&lt;br&gt;P07 Quyền lợi sáng; P08 Ăn uống&lt;br&gt;B03, B04, B05" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F7FAFE;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="565" y="310" width="470" height="245" /></mxCell><mxCell id="group2" value="&lt;b&gt;CUNG ỨNG VÀ VẬN HÀNH&lt;/b&gt;&lt;br&gt;&lt;br&gt;P09 Đặt mua; P10 Nhận hàng&lt;br&gt;P11 Biến động và tồn kho&lt;br&gt;P12 Bảo trì tài sản&lt;br&gt;B06, B07, B08" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F7FAFE;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1065" y="310" width="470" height="245" /></mxCell><mxCell id="conformed" value="&lt;b&gt;GÓC NHÌN DÙNG CHUNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Thời gian, cụm, khách sạn và các chiều nghiệp vụ được dùng nhất quán. Vai trò phục vụ, đặt phòng và giới thiệu phải phân biệt; hồ sơ khách hai nguồn chưa được hợp nhất thành một người duy nhất." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#EFF9F7;strokeColor=#087B7B;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="605" width="960" height="175" /></mxCell><mxCell id="context" value="&lt;b&gt;NGỮ CẢNH THỜI TIẾT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một cụm / ngày. Hỗ trợ phân tích B05; chưa định nghĩa mùa cao/thấp điểm và không chứng minh quan hệ nhân quả." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="605" width="475" height="175" /></mxCell><mxCell id="legend" value="&lt;b&gt;CÁCH ĐỌC CÁC SƠ ĐỒ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hộp vuông: hiện tượng cần đo. Hộp bo góc: chiều phân tích. Mũi tên cấp tổng hợp: chi tiết → khái quát. A: cộng được; U: chỉ cộng cùng đơn vị; S: không cộng số dư qua ngày; N: không cộng hoặc là ngữ cảnh. F/P/D chỉ để truy vết các tài liệu, không phải cột dữ liệu." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="825" width="1470" height="135" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-1" name="01-cap-thoi-gian-dia-diem"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Cấp tổng hợp - Thời gian và khách sạn" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Mũi tên từ mức chi tiết đến mức khái quát; quan hệ xét tại đúng thời điểm nghiệp vụ." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="H01name" value="&lt;b&gt;Thời gian&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="175" width="260" height="70" /></mxCell><mxCell id="H010" value="&lt;b&gt;Ngày&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="175" width="245" height="70" /></mxCell><mxCell id="H011" value="&lt;b&gt;Tháng trong năm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="175" width="245" height="70" /></mxCell><mxCell id="H012" value="&lt;b&gt;Quý trong năm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="935" y="175" width="245" height="70" /></mxCell><mxCell id="H013" value="&lt;b&gt;Năm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="175" width="245" height="70" /></mxCell><mxCell id="H01rule" value="Tháng/quý phải kèm năm; không gộp tháng 1 của nhiều năm như một thành viên. Thứ trong tuần là thuộc tính phân nhóm; mùa du lịch chưa có quy tắc theo cụm." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="267" width="1150" height="100" /></mxCell><mxCell id="H02name" value="&lt;b&gt;Phòng và địa điểm&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="435" width="260" height="70" /></mxCell><mxCell id="H020" value="&lt;b&gt;Phòng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="435" width="245" height="70" /></mxCell><mxCell id="H021" value="&lt;b&gt;Khách sạn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="435" width="245" height="70" /></mxCell><mxCell id="H022" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="935" y="435" width="245" height="70" /></mxCell><mxCell id="H023" value="&lt;b&gt;CompanyE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="435" width="245" height="70" /></mxCell><mxCell id="H02rule" value="Mỗi phòng thuộc một khách sạn tại thời điểm phân tích. Hạng sao và loại phòng là nhánh phân loại riêng, không phải các cấp nằm giữa hotel và site." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="527" width="1150" height="100" /></mxCell><mxCell id="H06name" value="&lt;b&gt;Tài sản khách sạn&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="695" width="260" height="70" /></mxCell><mxCell id="H060" value="&lt;b&gt;Tài sản&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="695" width="245" height="70" /></mxCell><mxCell id="H061" value="&lt;b&gt;Khách sạn quản lý&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="695" width="245" height="70" /></mxCell><mxCell id="H062" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="935" y="695" width="245" height="70" /></mxCell><mxCell id="H063" value="&lt;b&gt;CompanyE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="695" width="245" height="70" /></mxCell><mxCell id="H06rule" value="Không bắt buộc đi qua Phòng: có tài sản khu chung không thuộc phòng. Bên bán tài sản không mặc định là nhà thầu sửa chữa." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="787" width="1150" height="100" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="H010" target="H011" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="H011" target="H012" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="H012" target="H013" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="H020" target="H021" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="H021" target="H022" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" edge="1" parent="1" source="H022" target="H023" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" edge="1" parent="1" source="H060" target="H061" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" edge="1" parent="1" source="H061" target="H062" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" edge="1" parent="1" source="H062" target="H063" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-2" name="02-cap-dich-vu"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Cấp tổng hợp - Ăn uống, giải trí và xe" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Mũi tên từ mức chi tiết đến mức khái quát; quan hệ xét tại đúng thời điểm nghiệp vụ." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="H03name" value="&lt;b&gt;Điểm ăn uống&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="175" width="260" height="70" /></mxCell><mxCell id="H030" value="&lt;b&gt;Điểm ăn uống&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="175" width="245" height="70" /></mxCell><mxCell id="H031" value="&lt;b&gt;Khách sạn phục vụ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="175" width="245" height="70" /></mxCell><mxCell id="H032" value="&lt;b&gt;Cụm phục vụ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="935" y="175" width="245" height="70" /></mxCell><mxCell id="H033" value="&lt;b&gt;CompanyE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="175" width="245" height="70" /></mxCell><mxCell id="H03rule" value="Nhà hàng/bar tổng hợp theo nơi phục vụ; khách sạn nơi đặt phòng là vai trò khác, không thay thế nơi phục vụ." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="267" width="1150" height="100" /></mxCell><mxCell id="H04name" value="&lt;b&gt;Hoạt động giải trí&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="435" width="260" height="70" /></mxCell><mxCell id="H040" value="&lt;b&gt;Hoạt động&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="435" width="245" height="70" /></mxCell><mxCell id="H041" value="&lt;b&gt;Trung tâm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="435" width="245" height="70" /></mxCell><mxCell id="H042" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="935" y="435" width="245" height="70" /></mxCell><mxCell id="H043" value="&lt;b&gt;CompanyE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="435" width="245" height="70" /></mxCell><mxCell id="H04rule" value="Chỉ cộng công suất có cùng đơn vị lượt hoạt động; đây không phải số khách duy nhất toàn trung tâm." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="527" width="1150" height="100" /></mxCell><mxCell id="H05name" value="&lt;b&gt;Phương tiện&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="695" width="260" height="70" /></mxCell><mxCell id="H050" value="&lt;b&gt;Phương tiện&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="695" width="245" height="70" /></mxCell><mxCell id="H051" value="&lt;b&gt;Trung tâm quản lý&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="645" y="695" width="245" height="70" /></mxCell><mxCell id="H052" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="935" y="695" width="245" height="70" /></mxCell><mxCell id="H053" value="&lt;b&gt;CompanyE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="695" width="245" height="70" /></mxCell><mxCell id="H05rule" value="Loại xe là nhánh phân nhóm khác. Tỷ lệ đội xe phải tính lại từ tổng ngày thuê / tổng ngày sẵn sàng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="787" width="1150" height="100" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="H030" target="H031" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="H031" target="H032" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="H032" target="H033" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="H040" target="H041" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="H041" target="H042" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" edge="1" parent="1" source="H042" target="H043" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" edge="1" parent="1" source="H050" target="H051" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" edge="1" parent="1" source="H051" target="H052" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" edge="1" parent="1" source="H052" target="H053" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-3" name="03-phan-loai"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Phân nhóm bổ sung và giới hạn tổng hợp" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Mũi tên từ mức chi tiết đến mức khái quát; quan hệ xét tại đúng thời điểm nghiệp vụ." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="H07name" value="&lt;b&gt;Kênh bán&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="175" width="260" height="70" /></mxCell><mxCell id="H070" value="&lt;b&gt;Kênh trong nguồn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="175" width="320" height="70" /></mxCell><mxCell id="H071" value="&lt;b&gt;Loại kênh&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="175" width="320" height="70" /></mxCell><mxCell id="H072" value="&lt;b&gt;Tất cả kênh trong nguồn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1085" y="175" width="320" height="70" /></mxCell><mxCell id="H07rule" value="Kênh booking và kênh vé có miền định danh riêng. Không coi cùng tên là cùng một kênh toàn doanh nghiệp." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="267" width="1150" height="100" /></mxCell><mxCell id="H08name" value="&lt;b&gt;Nhà cung cấp&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="435" width="260" height="70" /></mxCell><mxCell id="H080" value="&lt;b&gt;Nhà cung cấp&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="435" width="320" height="70" /></mxCell><mxCell id="H081" value="&lt;b&gt;Nhóm nhà cung cấp&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="435" width="320" height="70" /></mxCell><mxCell id="H082" value="&lt;b&gt;Tất cả nhà cung cấp&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1085" y="435" width="320" height="70" /></mxCell><mxCell id="H08rule" value="Cụm của supplier là phạm vi nhà cung cấp; cụm nhận hàng lấy từ khách sạn nhận, không thay bằng supplier site." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="527" width="1150" height="100" /></mxCell><mxCell id="H09name" value="&lt;b&gt;Mặt hàng và đơn vị&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="695" width="260" height="70" /></mxCell><mxCell id="H090" value="&lt;b&gt;Mặt hàng / quy cách&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="695" width="320" height="70" /></mxCell><mxCell id="H091" value="&lt;b&gt;Đơn vị cơ sở&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="695" width="320" height="70" /></mxCell><mxCell id="H09rule" value="Chỉ tổng lượng trong cùng đơn vị tương thích. Giá trị VND có thể cộng nhiều mặt hàng; không tạo tổng 10 kg + 5 cái = 15 đơn vị." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=22;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="787" width="1150" height="100" /></mxCell><mxCell id="flat" value="Hồ sơ khách, khuyến mãi, gói giá và bữa chưa có phân cấp chuẩn bổ sung; giữ là các chiều phẳng với thuộc tính mô tả." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="960" width="1470" height="55" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="H070" target="H071" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="H071" target="H072" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="H080" target="H081" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="H081" target="H082" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="H090" target="H091" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-4" name="P01"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="P01 - Tiếp nhận đặt phòng" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Nhu cầu B01, B02, B03 | Mỗi hộp fact có một grain riêng; đường nối chỉ mô tả góc nhìn phân tích." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F01" value="&lt;b&gt;ĐẶT PHÒNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;[A] Số booking&lt;br&gt;[A] Giá trị trước giảm&lt;br&gt;[A] Tổng giảm giá&lt;br&gt;[A] Khách phải trả&lt;br&gt;[A] Giảm giá CompanyE chịu&lt;br&gt;[A] Đối tác tài trợ&lt;br&gt;[A] Hoa hồng phân phối" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=24;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.0" y="325" width="440" height="370" /></mxCell><mxCell id="F01D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày đặt / đến / trả" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="205.0" width="310" height="118" /></mxCell><mxCell id="F01D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="205.0" width="310" height="118" /></mxCell><mxCell id="F01D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách sạn đặt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="450.0" width="310" height="118" /></mxCell><mxCell id="F01D05" value="&lt;b&gt;Kênh bán&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kênh booking" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="450.0" width="310" height="118" /></mxCell><mxCell id="F01D06" value="&lt;b&gt;Khuyến mãi&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="695.0" width="310" height="118" /></mxCell><mxCell id="F01D07" value="&lt;b&gt;Hồ sơ khách nguồn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Người đặt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="695.0" width="310" height="118" /></mxCell><mxCell id="F01grain" value="&lt;b&gt;GRAIN: Một lần đặt phòng ở trạng thái cuối snapshot.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giá trị giữ một lần mỗi booking. Phòng/gói giá chỉ lọc booking có liên quan; chưa phân bổ tiền xuống từng phòng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="815" width="1460" height="145" /></mxCell><mxCell id="process-note" value="Phòng và gói giá dùng để chọn booking có liên quan; chưa phân bổ giá trị booking xuống từng phòng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="9