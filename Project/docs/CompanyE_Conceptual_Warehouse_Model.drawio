acing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="205.0" width="175" height="118" /></mxCell><mxCell id="F14D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="205.0" width="175" height="118" /></mxCell><mxCell id="F14D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách sạn giữ kho" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="450.0" width="175" height="118" /></mxCell><mxCell id="F14D14" value="&lt;b&gt;Nhà cung cấp&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="695.0" width="175" height="118" /></mxCell><mxCell id="F14D15" value="&lt;b&gt;Mặt hàng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="695.0" width="175" height="118" /></mxCell><mxCell id="F14grain" value="&lt;b&gt;GRAIN: Một biến động của một lô hàng tại khách sạn.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tồn được suy từ lịch sử nhập - dùng - hủy. Hàng bị từ chối chưa nhập kho không trở thành hao hụt kho." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="815" width="720" height="145" /></mxCell><mxCell id="F15" value="&lt;b&gt;TỒN CUỐI NGÀY&lt;/b&gt;&lt;br&gt;&lt;br&gt;[S/U] Lượng tồn cuối ngày&lt;br&gt;[S] Giá trị tồn cuối ngày&lt;br&gt;[U] Lượng nhập trong ngày&lt;br&gt;[U] Lượng dùng trong ngày&lt;br&gt;[U] Lượng hủy trong ngày" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030.0" y="325" width="300" height="370" /></mxCell><mxCell id="F15D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày chốt tồn" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="205.0" width="175" height="118" /></mxCell><mxCell id="F15D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="205.0" width="175" height="118" /></mxCell><mxCell id="F15D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách sạn giữ kho" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="450.0" width="175" height="118" /></mxCell><mxCell id="F15D14" value="&lt;b&gt;Nhà cung cấp&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="695.0" width="175" height="118" /></mxCell><mxCell id="F15D15" value="&lt;b&gt;Mặt hàng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="695.0" width="175" height="118" /></mxCell><mxCell id="F15grain" value="&lt;b&gt;GRAIN: Một lô, khách sạn, mặt hàng tại cuối một ngày.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tổng hợp tùy chọn từ sổ kho. Số dư chỉ cộng các lô cùng thời điểm, không cộng qua nhiều ngày." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="815" width="720" height="145" /></mxCell><mxCell id="process-note" value="Tồn cuối ngày là tổng hợp tùy chọn; không cộng số dư qua ngày hoặc phân bổ số dư theo khu vực sử dụng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="975" width="1470" height="42" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="F14" target="F14D01" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="F14" target="F14D02" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="F14" target="F14D03" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="F14" target="F14D14" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="F14" target="F14D15" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" edge="1" parent="1" source="F15" target="F15D01" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" edge="1" parent="1" source="F15" target="F15D02" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" edge="1" parent="1" source="F15" target="F15D03" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" edge="1" parent="1" source="F15" target="F15D14" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-9" edge="1" parent="1" source="F15" target="F15D15" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-15" name="P12"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="P12 - Bảo trì tài sản khách sạn" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Nhu cầu B08 | Mỗi hộp fact có một grain riêng; đường nối chỉ mô tả góc nhìn phân tích." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F16" value="&lt;b&gt;CÔNG VIỆC BẢO TRÌ&lt;/b&gt;&lt;br&gt;&lt;br&gt;[A] Chi phí công việc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=24;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.0" y="325" width="440" height="370" /></mxCell><mxCell id="F16D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày bắt đầu / hoàn tất" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="205.0" width="310" height="118" /></mxCell><mxCell id="F16D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="205.0" width="310" height="118" /></mxCell><mxCell id="F16D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="450.0" width="310" height="118" /></mxCell><mxCell id="F16D04" value="&lt;b&gt;Phòng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phòng nếu xác định được" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="695.0" width="310" height="118" /></mxCell><mxCell id="F16D16" value="&lt;b&gt;Tài sản&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="695.0" width="310" height="118" /></mxCell><mxCell id="F16grain" value="&lt;b&gt;GRAIN: Một công việc bảo trì tài sản khách sạn.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chi phí theo ngày hoàn tất. Tài sản khu chung không tự làm ngừng cả khách sạn; ảnh hưởng phòng thuộc P03." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="815" width="1460" height="145" /></mxCell><mxCell id="process-note" value="Bên cung cấp tài sản không mặc định là nhà thầu bảo trì. Ngày phòng khả dụng ở P03." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="975" width="1470" height="42" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="F16" target="F16D01" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="F16" target="F16D02" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="F16" target="F16D03" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="F16" target="F16D04" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="F16" target="F16D16" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-16" name="C01"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Ngữ cảnh - Thời tiết theo cụm và ngày" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Hỗ trợ B05 khi phân tích theo thời tiết; không làm thay đổi grain lượt vào hoặc công suất." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F17" value="&lt;b&gt;THỜI TIẾT NGÀY&lt;/b&gt;&lt;br&gt;&lt;br&gt;[N] Nhiệt độ&lt;br&gt;[N*] Lượng mưa&lt;br&gt;[N] Cờ thời tiết cực đoan" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=24;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.0" y="325" width="440" height="370" /></mxCell><mxCell id="F17D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày thời tiết" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="450" width="310" height="118" /></mxCell><mxCell id="F17D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="450" width="310" height="118" /></mxCell><mxCell id="F17grain" value="&lt;b&gt;GRAIN: Một cụm du lịch trong một ngày quan sát giả lập.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngữ cảnh, không là quá trình giao dịch thứ 13. Mưa cộng qua ngày trong cùng cụm; không SUM nhiệt độ hoặc suy nhân quả." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="815" width="1460" height="145" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="F17" target="F17D01" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="F17" target="F17D02" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-17" name="coverage"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Từ nhu cầu quyết định đến các khái niệm" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Tám nhu cầu và 47 KPI đã chốt được truy vết; không tạo thêm nhu cầu nghiệp vụ." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="B01" value="&lt;b&gt;B01 - Đánh giá hoạt động lưu trú&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="160" width="510" height="80" /></mxCell><mxCell id="B01facts" value="F01 đặt phòng, F02 phòng khả dụng, F03 đêm lưu trú" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="160" width="935" height="80" /></mxCell><mxCell id="B02" value="&lt;b&gt;B02 - Đánh giá kênh bán và khuyến mãi&lt;/b&gt;&lt;br&gt;&lt;br&gt;6 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="252" width="510" height="80" /></mxCell><mxCell id="B02facts" value="F01 đặt phòng" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="252" width="935" height="80" /></mxCell><mxCell id="B03" value="&lt;b&gt;B03 - Phân tích bán chéo khách sạn và giải trí&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="344" width="510" height="80" /></mxCell><mxCell id="B03facts" value="F01 đặt phòng, F04 đơn vé giải trí, F05 hợp đồng thuê xe" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="344" width="935" height="80" /></mxCell><mxCell id="B04" value="&lt;b&gt;B04 - Đánh giá buffet và nhà hàng&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="436" width="510" height="80" /></mxCell><mxCell id="B04facts" value="F06 quyền lợi sáng, F07 hóa đơn ăn uống, F08 phiên buffet" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="436" width="935" height="80" /></mxCell><mxCell id="B05" value="&lt;b&gt;B05 - Đánh giá giải trí và phương tiện&lt;/b&gt;&lt;br&gt;&lt;br&gt;6 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="528" width="510" height="80" /></mxCell><mxCell id="B05facts" value="F09 lượt vào hoạt động, F10 công suất hoạt động, F11 ngày xe" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="528" width="935" height="80" /></mxCell><mxCell id="B06" value="&lt;b&gt;B06 - Đánh giá giao hàng nhà cung cấp&lt;/b&gt;&lt;br&gt;&lt;br&gt;7 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="620" width="510" height="80" /></mxCell><mxCell id="B06facts" value="F12 dòng đặt mua, F13 lần nhận hàng" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="620" width="935" height="80" /></mxCell><mxCell id="B07" value="&lt;b&gt;B07 - Kiểm soát tồn kho và hao hụt&lt;/b&gt;&lt;br&gt;&lt;br&gt;6 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="712" width="510" height="80" /></mxCell><mxCell id="B07facts" value="F14 biến động kho, F15 tồn cuối ngày" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="712" width="935" height="80" /></mxCell><mxCell id="B08" value="&lt;b&gt;B08 - Đánh giá bảo trì và khả năng cung cấp phòng&lt;/b&gt;&lt;br&gt;&lt;br&gt;4 KPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="804" width="510" height="80" /></mxCell><mxCell id="B08facts" value="F02 phòng khả dụng, F16 công việc bảo trì" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=20;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="804" width="935" height="80" /></mxCell><mxCell id="coverage-note" value="B05 còn dùng thời tiết làm ngữ cảnh tùy bộ lọc. F15 là tổng hợp tùy chọn của F14; không có F15 vẫn tính được B07. Mã KPI và công thức chi tiết giữ trong hợp đồng KPI hiện có." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#EFF9F7;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="925" width="1470" height="85" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-18" name="rules"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Quy tắc ý niệm cần giữ khi triển khai" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Ràng buộc ý nghĩa và tổng hợp; chưa quyết định schema vật lý hoặc cấu trúc lưu trữ." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="rule0" value="&lt;b&gt;Đúng grain trước khi cộng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Booking, đêm phòng, hóa đơn, phiên buffet và lượt vào là các sự kiện khác nhau. Tổng hợp từng nguồn về cùng mức trước khi so sánh; không nối nhiều fact chi tiết rồi cộng tiền." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="170" width="715" height="205" /></mxCell><mxCell id="rule1" value="&lt;b&gt;Tỷ lệ tính lại từ các số cơ sở&lt;/b&gt;&lt;br&gt;&lt;br&gt;Công suất, tỷ lệ dùng quyền lợi, đáp ứng hàng và hao hụt đều là số đo không cộng được. Tính tổng tử / tổng mẫu; mẫu số 0 để trống, không gán 0%." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="170" width="715" height="205" /></mxCell><mxCell id="rule2" value="&lt;b&gt;Số dư theo thời điểm và đơn vị&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tồn cuối ngày không cộng qua nhiều ngày. Lượng chỉ cộng khi đơn vị tương thích; giá trị VND cộng được giữa các mặt hàng. Giá danh mục không thay giá giao dịch." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="405" width="715" height="205" /></mxCell><mxCell id="rule3" value="&lt;b&gt;Giữ ngữ cảnh lịch sử&lt;/b&gt;&lt;br&gt;&lt;br&gt;Phân loại giao dịch theo thuộc tính và quan hệ tại thời điểm nghiệp vụ. Đã chọn giữ phiên bản; v2 hiện có một phiên bản khởi tạo theo giả định mô phỏng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="405" width="715" height="205" /></mxCell><mxCell id="rule4" value="&lt;b&gt;Báo cáo phần hợp lệ và nói rõ phần thiếu&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khi còn lỗi, báo cáo vẫn dùng tập hợp lệ với nhãn thiếu và phạm vi ảnh hưởng. Không đủ dữ liệu khác với không phát sinh; không tự thay giá trị thiếu bằng 0." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="640" width="715" height="205" /></mxCell><mxCell id="rule5" value="&lt;b&gt;Phạm vi và giới hạn của mô hình&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chưa bổ sung KPI hội viên, dòng tiền, ROI, lợi nhuận đầy đủ hay định danh khách toàn chuỗi. Chưa suy mùa du lịch, tỉnh/vùng hành chính hoặc kho vật lý riêng từ nguồn không có thuộc tính đó." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="640" width="715" height="205" /></mxCell><mxCell id="reference" value="&lt;b&gt;CƠ SỞ TRÌNH BÀY&lt;/b&gt;&lt;br&gt;&lt;br&gt;CO5173 Chapter 2: trang 65 (Dimensions), 66 (Facts), 68 (Fact scheme); trang 56 (tính cộng được). Ký hiệu được điều chỉnh cho CompanyE. Conceptual model này là đầu vào để cập nhật sơ đồ luận lý ở bước tiếp theo; không tự thay đổi DDL, seed hoặc nguồn." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#EFF9F7;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="900" width="1470" height="110" /></mxCell></root></mxGraphModel></diagram></mxfile>