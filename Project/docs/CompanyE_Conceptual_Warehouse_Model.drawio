agram><diagram id="conceptual-13" name="P10"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="P10 - Tiếp nhận hàng mua" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Nhu cầu B06 | Mỗi hộp fact có một grain riêng; đường nối chỉ mô tả góc nhìn phân tích." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F13" value="&lt;b&gt;LẦN NHẬN HÀNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;[U] Lượng nhận đạt&lt;br&gt;[U] Lượng bị từ chối&lt;br&gt;[U] Lượng đạt nhưng nhận trễ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=24;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.0" y="325" width="440" height="370" /></mxCell><mxCell id="F13D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày nhận / hẹn / hạn*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="205.0" width="310" height="118" /></mxCell><mxCell id="F13D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="205.0" width="310" height="118" /></mxCell><mxCell id="F13D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách sạn nhận" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillCol