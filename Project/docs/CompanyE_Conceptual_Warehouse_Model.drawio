ometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Nhu cầu B03, B05 | Mỗi hộp fact có một grain riêng; đường nối chỉ mô tả góc nhìn phân tích." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F05" value="&lt;b&gt;HỢP ĐỒNG THUÊ XE&lt;/b&gt;&lt;br&gt;&lt;br&gt;[A] Giá trị thuê thỏa thuận" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.0" y="325" width="300" height="370" /></mxCell><mxCell id="F05D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày nhận / trả xe; cohort*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="205.0" width="175" height="118" /></mxCell><mxCell id="F05D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cụm phục vụ / booking*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="205.0" width="175" height="118" /></mxCell><mxCell id="F05D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách sạn giới thiệu*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="368.33333333333337" width="175" height="118" /></mxCell><mxCell id="F05D05" value="&lt;b&gt;Kênh bán&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kênh booking*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="450.0" width="175" height="118" /></mxCell><mxCell id="F05D07" value="&lt;b&gt;Hồ sơ khách nguồn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Người thuê" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="531.6666666666667" width="175" height="118" /></mxCell><mxCell id="F05D11" value="&lt;b&gt;Trung tâm giải trí&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="695.0" width="175" height="118" /></mxCell><mxCell id="F05D13" value="&lt;b&gt;Phương tiện&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="695.0" width="175" height="118" /></mxCell><mxCell id="F05grain" value="&lt;b&gt;GRAIN: Một hợp đồng thuê một phương tiện.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Số tiền một lần mỗi hợp đồng. Ngày sử dụng xe được đánh giá bằng khái niệm ngày xe ở hình bên cạnh." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="815" width="720" height="145" /></mxCell><mxCell id="F11" value="&lt;b&gt;NGÀY XE&lt;/b&gt;&lt;br&gt;&lt;br&gt;[A] Ngày xe danh mục&lt;br&gt;[A] Ngày bảo trì&lt;br&gt;[A] Ngày xe sẵn sàng&lt;br&gt;[A] Ngày xe được thuê" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030.0" y="325" width="300" height="370" /></mxCell><mxCell id="F11D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày xe" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="205.0" width="175" height="118" /></mxCell><mxCell id="F11D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="205.0" width="175" height="118" /></mxCell><mxCell id="F11D11" value="&lt;b&gt;Trung tâm giải trí&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="695.0" width="175" height="118" /></mxCell><mxCell id="F11D13" value="&lt;b&gt;Phương tiện&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="695.0" width="175" height="118" /></mxCell><mxCell id="F11grain" value="&lt;b&gt;GRAIN: Một phương tiện trong một ngày công suất.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không đồng nhất hợp đồng với ngày xe. Ngày thuê/bảo trì trùng nhau là dữ liệu xung đột cần báo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=18;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="815" width="720" height="145" /></mxCell><mxCell id="process-note" value="Hợp đồng và ngày xe có grain riêng; khách/kênh không lọc ngày xe sẵn sàng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fil