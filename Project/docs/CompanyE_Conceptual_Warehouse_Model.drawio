;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="695.0" width="310" height="118" /></mxCell><mxCell id="F03D08" value="&lt;b&gt;Gói giá&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="695.0" width="310" height="118" /></mxCell><mxCell id="F03grain" value="&lt;b&gt;GRAIN: Một phòng trong một đêm thực ở hợp lệ.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đêm thực ở khác ngày dự kiến. Bộ lọc kênh/khách chỉ phân loại đêm bán, không chia mẫu số công suất." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="815" width="1460" height="145" /></mxCell><mxCell id="process-note" value="Đêm thực ở; phân biệt kênh của đêm bán với mẫu số công suất." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="975" width="1470" height="42" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="F03" target="F03D01" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="F03" target="F03D02" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="F03" target="F03D03" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="F03" target="F03D04" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="F03" target="F03D05" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" edge="1" parent="1" source="F03" target="F03D07" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" edge="1" parent="1" source="F03" target="F03D08" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-6" name="P03"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="P03 - Theo dõi phòng khả dụng" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Nhu cầu B01, B08 | Mỗi hộp fact có một grain riêng; đường nối chỉ mô tả góc nhìn phân tích." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F02" value="&lt;b&gt;PHÒNG KHẢ DỤNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;[A] Ngày phòng danh mục&lt;br&gt;[A] Ngày phòng bị chặn&lt;br&gt;[A] Ngày phòng khả dụng" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=24;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.0" y="325" width="440" height="370" /></mxCell><mxCell id="F02D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày công suất" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="205.0" width="310" height="118" /></mxCell><mxCell id="F02D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="205.0" width="310" height="118" /></mxCell><mxCell id="F02D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="695.0" width="310" height="118" /></mxCell><mxCell id="F02D04" value="&lt;b&gt;Phòng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="695.0" width="310" height="118" /></mxCell><mxCell id="F02grain" value="&lt;b&gt;GRAIN: Một phòng trong một ngày công suất.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giữ cả ngày không có khách. Các khoảng bảo trì chồng nhau chỉ làm mất một room-day." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="815" width="1460" height="145" /></mxCell><mxCell id="process-note" value="Room-day dùng chung cho lưu trú và ảnh hưởng bảo trì." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="975" width="