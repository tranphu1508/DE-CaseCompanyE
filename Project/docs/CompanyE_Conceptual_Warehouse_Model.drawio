04D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày bán / trả phòng*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="205.0" width="310" height="118" /></mxCell><mxCell id="F04D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cụm phục vụ / booking*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="205.0" width="310" height="118" /></mxCell><mxCell id="F04D03" value="&lt;b&gt;Khách sạn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách sạn giới thiệu*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="450.0" width="310" height="118" /></mxCell><mxCell id="F04D05" value="&lt;b&gt;Kênh bán&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kênh vé / booking*" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="450.0" width="310" height="118" /></mxCell><mxCell id="F04D07" value="&lt;b&gt;Hồ sơ khách nguồn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Người mua vé" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="695.0" width="310" height="118" /></mxCell><mxCell id="F04D11" value="&lt;b&gt;Trung tâm giải trí&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=23;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="695.0" width="310" height="118" /></mxCell><mxCell id="F04grain" value="&lt;b&gt;GRAIN: Một đơn mua vé.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đơn vé có thể bán độc lập hoặc gắn booking. Giá đơn không lặp theo từng vé hoặc lượt vào." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=21;fillColor=#F1F5FB;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="815" width="1460" height="145" /></mxCell><mxCell id="process-note" value="Khách sạn/kênh booking chỉ có khi có tham chiếu booking hợp lệ." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="975" width="1470" height="42" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="F04" target="F04D01" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="F04" target="F04D02" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="F04" target="F04D03" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" edge="1" parent="1" source="F04" target="F04D05" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" edge="1" parent="1" source="F04" target="F04D07" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" edge="1" parent="1" source="F04" target="F04D11" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#192B43;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="conceptual-8" name="P05"><mxGraphModel dx="1600" dy="1100" grid="1" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="P05 - Tiếp nhận lượt dùng hoạt động" style="text;html=0;align=left;fontFamily=Arial;fontSize=36;fontColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="30" width="1470" height="55" /></mxCell><mxCell id="subtitle" value="Nhu cầu B05 | Mỗi hộp fact có một grain riêng; đường nối chỉ mô tả góc nhìn phân tích." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#546476;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="98" width="1470" height="34" /></mxCell><mxCell id="F09" value="&lt;b&gt;LƯỢT VÀO HOẠT ĐỘNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;[A] Số lượt sử dụng hoạt động" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=19;fillColor=#F0F4FE;strokeColor=#11129C;" vertex="1" parent="1"><mxGeometry as="geometry" x="270.0" y="325" width="300" height="370" /></mxCell><mxCell id="F09D01" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày vào thực tế" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="205.0" width="175" height="118" /></mxCell><mxCell id="F09D02" value="&lt;b&gt;Cụm du lịch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=#192B43;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="205.0" width="175" height="118" /></mxCell><mxCell id="F09D07" value="&lt;b&gt;Hồ sơ khách nguồn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;fon