          <mxGeometry x="0" y="63" width="450" height="29" as="geometry" />
        </mxCell>
        <mxCell id="text0" value="Cùng mã D = cùng dimension logic. Một dimension&lt;br&gt;xuất hiện ở nhiều trang chỉ là bản vẽ lặp, không phải&lt;br&gt;bảng mới." style="text;html=1;fontFamily=Arial;fontSize=17;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1075" y="630" width="450" height="70.28" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="D01 DimDate và D02 DimSite được dùng ở cả 17 fact/bảng&lt;br&gt;tổng hợp. F15 tùy chọn; F17 là ngữ cảnh." style="text;html=1;fontFamily=Arial;fontSize=16;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1075" y="727" width="450" height="45.96" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Chọn Fact Constellation cho toàn hệ thống; mỗi fact giữ grain riêng. Các trang 03-19 là từng Star Schema. Trang 02 minh họa hai fact thực sự dùng chung dimension; trang 20 mô tả bridge và&lt;br&gt;liên kết có kiểm soát." style="text;html=1;fontFamily=Arial;fontSize=17;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="874" width="1450" height="48.52" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="PK: khóa chính | FK: khóa ngoại | BK: khóa nghiệp vụ | UQ: khóa duy nhất | M: số đo | DD: định danh giao dịch | *: có thể thiếu" style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1014" width="1450" height="21.64" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Dimension 1 (0..1 nếu FK*) - 0..N fact. BK/DD nguồn có namespace; Type 1 ở v2; D07 chưa hợp nhất khách. Chưa phải DDL, chưa vẽ đủ cột batch/lineage." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1039" width="1450" height="20.36" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="Mẫu: CO5173 Chương 2, slide 54-55, 59; CO4031 Chương 3, slide 17. CompanyE logical model v1.0 | 13/10/2026." style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1061" width="1430" height="19.08" as="geometry" />
        </mxCell>
        <mxCell id="page_number" value="01 / 20" style="text;html=1;fontFamily=Arial;fontSize=12;align=right;" vertex="1" parent="1">
          <mxGeometry x="1470" y="1068" width="90" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
