        <mxCell id="text0" value="UQ trong batch:&lt;br&gt;activity_key + date_key" style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
