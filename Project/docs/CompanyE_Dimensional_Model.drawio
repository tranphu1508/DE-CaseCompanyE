        </mxCell>
        <mxCell id="text1" value="Quy tắc: Tiền ghi một lần, không nhân theo ngày. Supplier của asset là bên bán tài sản, không coi là vendor bảo trì. Ngày chặn phòng dùng F02 và bridge overlap." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="915" width="1450" height="24.2" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Vai trò ngày: starts_on, ends_on; chi phí theo ends_on và COMPLETED." style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
