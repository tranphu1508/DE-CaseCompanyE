              <mxPoint x="1028.5" y="479.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="text0" value="Grain F12: một dòng đặt mua.&lt;br&gt;Grain F13: một lần nhận của một dòng đặt mua.&lt;br&gt;Một dòng mua có thể nhận hàng nhiều lần." style="text;html=1;fontFamily=Arial;fontSize=16;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="790" width="455" height="66.44" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="purchase_line_id là định danh đối chiếu. Tổng receipt về dòng&lt;br&gt;mua trước khi ghép để tính KPI; giữ cả dòng đến hạn chưa&lt;br&gt;nhận." style="text;html=1;fontFamily=Arial;fontSize=16;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="790" width="455" height="66.44" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Khóa chiều dùng chung giúp so sánh cùng kỳ, khách sạn, nhà cung cấp và mặt hàng. Các vai trò ordered / expected / received / expires đều tham chiếu cùng DimDate." style="text;html=1;fontFamily=Arial;fontSize=16;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="905" width="1450" height="25.48" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="PK: khóa chính | FK: khóa ngoại | BK: khóa nghiệp vụ | UQ: khóa duy nhất | M: số đo | DD: định danh giao dịch | *: có thể thiếu" style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1014" width="1450" height="21.64" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Dimension 1 (0..1 nếu FK*) - 0..N fact. BK/DD nguồn có namespace; Type 1 ở v2; D07 chưa hợp nhất khách. Chưa phải DDL, chưa vẽ đủ cột batch/lineage." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1039" width="1450" height="20.36" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="Mẫu: CO5173 Chương 2, slide 54-55, 59; CO4031 Chương 3, slide 17. CompanyE logical model v1.0 | 13/10/2026." style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1061" width="1430" height="19.08" as="geometry" />
        </mxCell>
        <mxCell id="page_number" value="02 / 20" style="text;html=1;fontFamily=Arial;fontSize=12;align=right;" vertex="1" parent="1">
          <mxGeometry x="1470" y="1068" width="90" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
