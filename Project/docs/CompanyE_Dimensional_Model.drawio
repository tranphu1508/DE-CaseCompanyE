        <mxCell id="text0" value="UQ trong batch:&lt;br&gt;room_key + service_date_key" style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="539" width="490" height="40.84" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Quy tắc: Chỉ booking COMPLETED; overlap và ở trùng ngày ngừng bán là lỗi. Kênh có thể lọc đêm bán nhưng không tạo công suất theo kênh." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="915" width="1450" height="24.2" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Vai trò ngày: Mở rộng [checkin_date,checkout_date) thực tế." style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="965" width="1450" height="22.92" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="PK: khóa chính | FK: khóa ngoại | BK: khóa nghiệp vụ | UQ: khóa duy nhất | M: số đo | DD: định danh giao dịch | *: có thể thiếu" style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1014" width="1450" height="21.64" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Dimension 1 (0..1 nếu FK*) - 0..N fact. BK/DD nguồn có namespace; Type 1 ở v2; D07 chưa hợp nhất khách. Chưa phải DDL, chưa vẽ đủ cột batch/lineage." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1039" width="1450" height="20.36" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="Mẫu: CO5173 Chương 2, slide 54-55, 59; CO4031 Chương 3, slide 17. CompanyE logical model v1.0 | 13/10/2026." style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1061" width="1430" height="19.08" as="geometry" />
        </mxCell>
        <mxCell id="page_number" value="05 / 20" style="text;html=1;fontFamily=Arial;fontSize=12;align=right;" vertex="1" parent="1">
          <mxGeometry x="1470" y="1068" width="90" height="20" as="geometry" />
        </mxCell>
      </root>
