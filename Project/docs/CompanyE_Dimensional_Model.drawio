        </mxCell>
        <mxCell id="text1" value="Quy tắc: Closure đóng trọn ngày; gộp nhiều lý do trước khi tính. Không có phân bổ capacity theo khách, kênh hoặc khách sạn giới thiệu." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
