        <mxCell id="text0" value="UQ trong batch:&lt;br&gt;source_system + booking_id" style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="643" width="490" height="40.84" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Quy tắc: B02 chỉ COMPLETED; không nhân giá theo phòng, vé hoặc revision. Room type lọc booking qua EXISTS BridgeBookingRoom, không phân bổ tiền ngầm." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="915" width="1450" height="24.2" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="Vai trò ngày: booked_on; arrival cho B01.04–05; departure cho B02–B03." style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="965" width="1450" height="22.92" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="PK: khóa chính | FK: khóa ngoại | BK: khóa nghiệp vụ | UQ: khóa duy nhất | M: số đo | DD: định danh giao dịch | *: có thể thiếu" style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="75" y="1014" width="1450" height="21.64" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Dimension 1 (0..1 nếu FK*) - 0..N fact. BK/DD nguồn có namespace; Type 1 ở v2; D07 chưa hợp nhất khách. Chưa phải DDL, chưa vẽ đủ cột batch/lineage." style="text;html=1;fontFamily=Arial;fontSize=12;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
