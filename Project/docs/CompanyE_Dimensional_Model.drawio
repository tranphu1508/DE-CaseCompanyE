        </mxCell>
        <mxCell id="text1" value="F02 lấy DISTINCT room/date để tính ngày ngừng bán. maintenance_id truy&lt;br&gt;vết F16; không SUM cost sau khi nối nhiều ngày." style="text;html=1;fontFamily=Arial;fontSize=16;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
