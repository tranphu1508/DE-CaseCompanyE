        </mxCell>
        <mxCell id="text1" value="Quy tắc: Hợp DISTINCT mọi khoảng bảo trì [starts_on,ends_on). Dùng chung B01.02 và B08.03; không chịu bộ lọc kênh/khách hoặc loại công việc chi phí." style="text;html=1;fontFamily=Arial;fontSize=15;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
