        </mxCell>
        <mxCell id="text2" value="Vai trò ngày: calendar_date trong [S,E)." style="text;html=1;fontFamily=Arial;fontSize=14;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
